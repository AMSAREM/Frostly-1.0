# ------------------------------------------------------------------------------
# Frostly Environment Configuration Template
# ------------------------------------------------------------------------------

# Public canonical URL for web links, email confirmation redirects, and OAuth
APP_PUBLIC_URL=

# Platform Creator & Primary Operator configuration
# Verified creator email address that possesses top-level platform administrative rights
CREATOR_EMAIL=
CREATOR_PASSWORD=

# Recipient email address for platform feedback submissions and operational escalations
FEEDBACK_RECIPIENT_EMAIL=

# Stripe Billing & Subscription Secrets (Server-side only; never prefix with VITE_)
# Stripe restricted/secret API key for subscription creation and webhook verification
STRIPE_SECRET_KEY=
# Stripe webhook endpoint signing secret (whsec_...) for cryptographically validating incoming Stripe events
STRIPE_WEBHOOK_SECRET=

# Paystack Dual-Billing Secrets (Server-side only; never prefix with VITE_)
# Paystack secret API key (sk_live_... / sk_test_...) for processing GHS payments and mobile money
PAYSTACK_SECRET_KEY=

# Primary Multi-tenant Workspace Identifier
AMANSOCEAN_ORG_ID=

# Database Connection URLs (Direct PostgreSQL access)
DATABASE_URL=
SUPABASE_DB_URL=

# Google SMTP Credentials (Used for transactional email dispatches & confirmations)
GOOGLE_SMTP_USER=
GOOGLE_SMTP_APP_PASSWORD=
GOOGLE_SMTP_FROM_EMAIL=
GOOGLE_SMTP_FROM_NAME=

# Supabase Server-side Credentials (Privileged service role key; never expose to client)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Client-facing Supabase Configuration (Safe for browser bundle)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Local Development / Demo Test Credentials
VITE_DEV_CREATOR_EMAIL=
VITE_DEV_CREATOR_PASSWORD=
VITE_DEV_TEST_USER_EMAIL=
VITE_DEV_TEST_USER_PASSWORD=